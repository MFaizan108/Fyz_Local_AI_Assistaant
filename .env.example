OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0.6
OLLAMA_NUM_PREDICT=220
OLLAMA_NUM_PREDICT_INTENT=200
OLLAMA_CONNECT_TIMEOUT=10
OLLAMA_READ_TIMEOUT=90
EMBED_MODEL=nomic-embed-text
WHISPER_MODEL_SIZE=base
WHISPER_LANGUAGE=ur
# Piper Urdu neural TTS (Brain v3.2). Leave the two PATH vars blank to use
# the default download location documented in README (voice/models/piper/).
TTS_ENABLED=true
PIPER_ENABLED=true
PIPER_VOICE_PATH=
PIPER_CONFIG_PATH=
TTS_FALLBACK_TO_PYTTSX3=false
